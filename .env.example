# Everything is optional: `npm run dev` works with no .env at all.

# Your own Postgres 15+. Leave unset to use the embedded Postgres in .data/postgres.
# DATABASE_URL=postgres://user:password@localhost:5432/chat

# Invited as the workspace owner by the seed (default: owner@example.com).
# OWNER_EMAIL=you@company.com

# Name of the workspace created by the seed (only #general, no demo data).
# WORKSPACE_NAME=Default Workspace
